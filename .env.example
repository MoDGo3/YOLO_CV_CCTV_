# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ไม่ขึ้น GitHub)
# copy .env.example .env

# === กล้อง RTSP (Hikvision) ===
RTSP_USER=admin
RTSP_PASSWORD=change_me
RTSP_HOST=192.168.1.2
RTSP_PORT=554
# 101 = Main Stream 1080p, 102 = Sub Stream 640x480
RTSP_CHANNEL=101
# หรือกำหนด URL เต็มแทนค่าด้านบน:
# RTSP_URL=rtsp://user:pass@host:554/Streaming/Channels/101

# === MQTT ===
# ห้ามใช้ broker สาธารณะ (เช่น test.mosquitto.org) เพราะข้อความมีข้อมูลเพศ/อายุ/เชื้อชาติ
MQTT_BROKER=localhost
# 1883 = ไม่เข้ารหัส, 8883 = TLS
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
# path ไฟล์ CA ถ้า broker ใช้ certificate ที่เซ็นเอง (เว้นว่าง = ใช้ CA ของระบบ)
MQTT_CA_CERTS=
# true = ไม่ตรวจชื่อ host ใน certificate (ใช้ทดสอบเท่านั้น)
MQTT_TLS_INSECURE=false
